<!--
  Punto's tablet: the library of saved games and models, the menu of concept t1
  (concepts/tablet/t1-hold.png): underlined tabs, a MINE / EVERYONE toggle, LIVE with avatars,
  soft tinted cards with the title centred under the picture.
  1200 x 800 units (a unit is 1 cm before scaling), scaled to ~48 cm in src/library/tablet.ts.
  Four views, one shown at a time: #grid-view, #detail-view, #live-view, #invite-view.
  Element ids are read by src/library/tablet.ts; card slots (0-5), live rows (0-3) and the two
  LIVE avatars are filled from code, and so are the card tints.
-->
<style>
  .screen {
    width: 1200;
    height: 800;
    flex-direction: column;
    padding-top: 30;
    padding-bottom: 24;
    padding-left: 40;
    padding-right: 40;
    border-radius: 64;
    background-color: #0d1113;
  }

  .top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 76;
  }

  .side {
    width: 260;
    flex-direction: row;
    align-items: center;
  }

  .side-end {
    width: 260;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 10;
  }

  .tabs {
    flex-direction: column;
    align-items: center;
  }

  .tab-row {
    flex-direction: row;
  }

  .tab {
    width: 200;
    height: 64;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 12;
    cursor: pointer;
  }

  .tab-label {
    color: #8e9a9c;
    font-size: 34;
    font-weight: 700;
  }

  .tab-bar {
    width: 200;
    height: 6;
    border-radius: 3;
    background-color: #0d1113;
  }

  .tab-line {
    width: 600;
    height: 2;
    background-color: #2b3537;
  }

  .scope {
    flex-direction: row;
    align-items: center;
    align-self: center;
    gap: 16;
    margin-top: 12;
  }

  .scope-label {
    color: #8e9a9c;
    font-size: 22;
    font-weight: 700;
    cursor: pointer;
  }

  .toggle {
    width: 74;
    height: 40;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 5;
    padding-right: 5;
    border-radius: 20;
    background-color: #3a4446;
    cursor: pointer;
  }

  .knob {
    width: 30;
    height: 30;
    border-radius: 15;
    background-color: #e8eded;
  }

  .round {
    width: 56;
    height: 56;
    align-items: center;
    justify-content: center;
    border-radius: 28;
    background-color: #161d20;
    border-width: 2;
    border-color: #26302f;
    cursor: pointer;
  }

  .round:hover {
    border-color: #62e9f2;
  }

  .live {
    flex-direction: row;
    align-items: center;
    gap: 10;
    cursor: pointer;
  }

  .live-label {
    color: #e6eeee;
    font-size: 22;
    font-weight: 700;
  }

  .dot {
    width: 14;
    height: 14;
    border-radius: 7;
    background-color: #ff4d5e;
  }

  .avatars {
    flex-direction: row;
    gap: 4;
  }

  .avatar {
    width: 44;
    height: 44;
    align-items: center;
    justify-content: center;
    border-radius: 22;
    border-width: 2;
    border-color: #e8eded;
    background-color: #c0703f;
  }

  .avatar-letter {
    color: #ffffff;
    font-size: 20;
    font-weight: 800;
  }

  .column {
    flex-direction: column;
  }

  .grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 24;
    margin-top: 22;
    padding-left: 14;
  }

  .card {
    width: 352;
    height: 252;
    flex-direction: column;
    align-items: center;
    padding-top: 8;
    border-radius: 34;
    border-width: 2;
    border-color: #3c4548;
    background-color: #2a3134;
    cursor: pointer;
  }

  .card:hover {
    border-color: #62e9f2;
  }

  .thumb {
    width: 332;
    height: 187;
    border-radius: 26;
  }

  .card-name {
    margin-top: 10;
    color: #f4f7f7;
    font-size: 28;
    font-weight: 600;
  }

  .bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16;
    height: 56;
  }

  .pager {
    flex-direction: row;
    align-items: center;
    gap: 16;
  }

  .muted {
    color: #7f8d8f;
    font-size: 21;
  }

  .empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14;
    height: 520;
  }

  .empty-big {
    color: #e6eeee;
    font-size: 34;
    font-weight: 700;
  }

  .primary {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14;
    height: 74;
    border-radius: 37;
    background-color: #62e9f2;
    cursor: pointer;
  }

  .primary:hover {
    background-color: #8af1f7;
  }

  .primary-label {
    color: #04191c;
    font-size: 27;
    font-weight: 700;
  }

  .ghost {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 12;
    height: 66;
    border-radius: 33;
    border-width: 2;
    border-color: #3a4a4c;
    background-color: #161d20;
    cursor: pointer;
  }

  .ghost:hover {
    border-color: #62e9f2;
  }

  .ghost-label {
    color: #e6eeee;
    font-size: 24;
    font-weight: 700;
  }

  .detail {
    flex-direction: row;
    align-items: center;
    gap: 34;
    margin-top: 10;
    height: 620;
  }

  .detail-thumb {
    width: 660;
    height: 371;
    border-radius: 34;
  }

  .detail-side {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    gap: 20;
  }

  .detail-title {
    color: #f6fafa;
    font-size: 50;
    font-weight: 800;
  }

  .row {
    flex-direction: row;
    align-items: center;
    gap: 12;
  }

  .live-list {
    flex-direction: column;
    gap: 16;
    margin-top: 18;
  }

  .live-row {
    flex-direction: row;
    align-items: center;
    gap: 22;
    height: 128;
    padding-left: 14;
    padding-right: 20;
    border-radius: 30;
    border-width: 2;
    border-color: #3c4548;
    background-color: #1c2427;
  }

  .live-thumb {
    width: 170;
    height: 96;
    border-radius: 20;
  }

  .live-text {
    flex-grow: 1;
    flex-direction: column;
    gap: 6;
  }

  .live-title {
    color: #f4f7f7;
    font-size: 28;
    font-weight: 600;
  }

  .join {
    flex-direction: row;
    align-items: center;
    gap: 10;
    height: 62;
    padding-left: 26;
    padding-right: 26;
    border-radius: 31;
    background-color: #62e9f2;
    cursor: pointer;
  }

  .join:hover {
    background-color: #8af1f7;
  }

  .qr-card {
    width: 440;
    height: 440;
    align-items: center;
    justify-content: center;
    border-radius: 40;
    background-color: #ffffff;
  }

  .qr {
    width: 380;
    height: 380;
  }

  .link {
    color: #62e9f2;
    font-size: 20;
  }

  .toast {
    position-type: absolute;
    position-bottom: 26;
    position-left: 350;
    width: 500;
    height: 58;
    align-items: center;
    justify-content: center;
    border-radius: 29;
    background-color: #62e9f2;
  }

  .toast-label {
    color: #04191c;
    font-size: 23;
    font-weight: 700;
  }
</style>
<div class="screen">
  <div class="top">
    <div class="side">
      <div id="save" class="round"><Bookmark width="26" height="26" color="#62e9f2"></Bookmark></div>
    </div>
    <div class="tabs">
      <div class="tab-row">
        <div id="tab-game" class="tab"><span id="tab-game-label" class="tab-label">GAMES</span><div id="tab-game-bar" class="tab-bar"></div></div>
        <div id="tab-model" class="tab"><span id="tab-model-label" class="tab-label">MODELS</span><div id="tab-model-bar" class="tab-bar"></div></div>
        <div id="tab-recent" class="tab"><span id="tab-recent-label" class="tab-label">RECENT</span><div id="tab-recent-bar" class="tab-bar"></div></div>
      </div>
      <div class="tab-line"></div>
    </div>
    <div class="side-end">
      <div id="live" class="live">
        <span class="live-label">LIVE</span>
        <div id="live-dot" class="dot"></div>
        <div class="avatars">
          <div id="live-av-0" class="avatar"><span id="live-av-letter-0" class="avatar-letter">?</span></div>
          <div id="live-av-1" class="avatar"><span id="live-av-letter-1" class="avatar-letter">?</span></div>
        </div>
      </div>
    </div>
  </div>

  <div id="grid-view" class="column">
    <div id="scope" class="scope">
      <span id="scope-mine" class="scope-label">MINE</span>
      <div id="scope-toggle" class="toggle">
        <div id="knob-mine" class="knob"></div>
        <div id="knob-all" class="knob"></div>
      </div>
      <span id="scope-all" class="scope-label">EVERYONE</span>
    </div>
    <div id="grid" class="grid">
      <div id="card-0" class="card"><img id="thumb-0" class="thumb" src="" /><span id="name-0" class="card-name">-</span></div>
      <div id="card-1" class="card"><img id="thumb-1" class="thumb" src="" /><span id="name-1" class="card-name">-</span></div>
      <div id="card-2" class="card"><img id="thumb-2" class="thumb" src="" /><span id="name-2" class="card-name">-</span></div>
      <div id="card-3" class="card"><img id="thumb-3" class="thumb" src="" /><span id="name-3" class="card-name">-</span></div>
      <div id="card-4" class="card"><img id="thumb-4" class="thumb" src="" /><span id="name-4" class="card-name">-</span></div>
      <div id="card-5" class="card"><img id="thumb-5" class="thumb" src="" /><span id="name-5" class="card-name">-</span></div>
    </div>
    <div id="empty" class="empty">
      <span id="empty-big" class="empty-big">Nothing saved yet</span>
      <span id="empty-small" class="muted">Make something with Punto and press save</span>
    </div>
    <div class="bottom">
      <span id="count" class="muted"> </span>
      <div class="pager">
        <div id="prev" class="round"><ChevronLeft width="28" height="28" color="#d6e4e5"></ChevronLeft></div>
        <span id="page" class="muted">1 / 1</span>
        <div id="next" class="round"><ChevronRight width="28" height="28" color="#d6e4e5"></ChevronRight></div>
      </div>
    </div>
  </div>

  <div id="detail-view" class="detail">
    <img id="detail-thumb" class="detail-thumb" src="" />
    <div class="detail-side">
      <div class="row">
        <div id="detail-back" class="round"><ArrowLeft width="28" height="28" color="#d6e4e5"></ArrowLeft></div>
      </div>
      <span id="detail-title" class="detail-title">-</span>
      <div class="row">
        <div id="detail-avatar" class="avatar"><span id="detail-letter" class="avatar-letter">?</span></div>
        <span id="detail-author" class="muted">-</span>
      </div>
      <span id="detail-credit" class="muted"> </span>
      <div id="detail-play" class="primary">
        <Play width="26" height="26" color="#04191c"></Play>
        <span id="detail-play-label" class="primary-label">PLAY IN MY ROOM</span>
      </div>
      <div id="detail-join" class="ghost">
        <div class="dot"></div>
        <span id="detail-join-label" class="ghost-label">JOIN LIVE</span>
      </div>
      <div id="detail-invite" class="ghost">
        <UserPlus width="24" height="24" color="#62e9f2"></UserPlus>
        <span class="ghost-label">INVITE A FRIEND</span>
      </div>
      <div id="detail-host" class="ghost">
        <Radio width="24" height="24" color="#62e9f2"></Radio>
        <span id="detail-host-label" class="ghost-label">LET OTHERS JOIN</span>
      </div>
    </div>
  </div>

  <div id="live-view" class="live-list">
    <div class="row">
      <div id="live-back" class="round"><ArrowLeft width="28" height="28" color="#d6e4e5"></ArrowLeft></div>
      <span class="empty-big">Playing now</span>
    </div>
    <div id="live-row-0" class="live-row"><img id="live-thumb-0" class="live-thumb" src="" /><div class="live-text"><span id="live-title-0" class="live-title">-</span><span id="live-host-0" class="muted">-</span></div><div id="live-join-0" class="join"><Users width="24" height="24" color="#04191c"></Users><span class="primary-label">JOIN</span></div></div>
    <div id="live-row-1" class="live-row"><img id="live-thumb-1" class="live-thumb" src="" /><div class="live-text"><span id="live-title-1" class="live-title">-</span><span id="live-host-1" class="muted">-</span></div><div id="live-join-1" class="join"><Users width="24" height="24" color="#04191c"></Users><span class="primary-label">JOIN</span></div></div>
    <div id="live-row-2" class="live-row"><img id="live-thumb-2" class="live-thumb" src="" /><div class="live-text"><span id="live-title-2" class="live-title">-</span><span id="live-host-2" class="muted">-</span></div><div id="live-join-2" class="join"><Users width="24" height="24" color="#04191c"></Users><span class="primary-label">JOIN</span></div></div>
    <div id="live-row-3" class="live-row"><img id="live-thumb-3" class="live-thumb" src="" /><div class="live-text"><span id="live-title-3" class="live-title">-</span><span id="live-host-3" class="muted">-</span></div><div id="live-join-3" class="join"><Users width="24" height="24" color="#04191c"></Users><span class="primary-label">JOIN</span></div></div>
    <span id="live-none" class="muted">Nobody has opened a game to others right now</span>
  </div>

  <div id="invite-view" class="detail">
    <div class="qr-card"><img id="invite-qr" class="qr" src="" /></div>
    <div class="detail-side">
      <div class="row">
        <div id="invite-back" class="round"><ArrowLeft width="28" height="28" color="#d6e4e5"></ArrowLeft></div>
      </div>
      <span class="detail-title">Invite a friend</span>
      <span id="invite-what" class="muted">-</span>
      <span class="muted">Scan with a phone and send it on, or share it from here.</span>
      <span id="invite-link" class="link">-</span>
      <div id="invite-share" class="primary">
        <Share2 width="26" height="26" color="#04191c"></Share2>
        <span class="primary-label">SHARE</span>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"><span id="toast-label" class="toast-label"> </span></div>
</div>
